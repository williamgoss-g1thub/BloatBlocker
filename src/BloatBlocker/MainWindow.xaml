<Window x:Class="BloatBlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BloatBlocker"
        xmlns:conv="clr-namespace:BloatBlocker.Converters"
        Title="BloatBlocker" Height="680" Width="760"
        Background="{StaticResource PageBgBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:StatusToBackgroundConverter x:Key="StatusBg"/>
        <conv:StatusToForegroundConverter x:Key="StatusFg"/>
        <conv:StatusToApplyVisibilityConverter x:Key="ApplyVis"/>
        <conv:StatusToRevertVisibilityConverter x:Key="RevertVis"/>
        <conv:ProtectionRingConverter x:Key="RingGeom"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Rectangle Width="4" Height="22" Fill="{StaticResource AccentGradientBrush}" RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
            <TextBlock Text="BloatBlocker" Style="{StaticResource TitleText}"/>
        </StackPanel>

        <!-- Hero: ring gauge + stats -->
        <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ring -->
                <Grid Grid.Column="0" Width="120" Height="120">
                    <Ellipse Width="100" Height="100" StrokeThickness="12" Stroke="{StaticResource Surface2Brush}"/>
                    <Path StrokeThickness="12" Stroke="{StaticResource AccentGradientBrush}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="120" Height="120">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource RingGeom}">
                                <Binding Path="ProtectedCount"/>
                                <Binding Path="TotalCount"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding ProtectedCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="protected" HorizontalAlignment="Center" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </Grid>

                <!-- Stats -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Protection status" Style="{StaticResource HeadingText}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding NeedsAttentionCount, Mode=OneWay}"/>
                            <Run Text="needs attention"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="last checked"/>
                            <Run Text="{Binding LastCheckedDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Reapply-all shortcut, only relevant when there's drift -->
                <Button Grid.Column="3" Content="Re-apply all" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ReapplyDriftedCommand}" VerticalAlignment="Center"
                        Visibility="{Binding HasDrift, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Drift banner -->
        <Border Grid.Row="2" Background="{StaticResource WarningBgBrush}" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,16"
                Visibility="{Binding HasDrift, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Windows update reverted some protected settings. Review below."
                       Style="{StaticResource BodyText}" Foreground="{StaticResource WarningBrush}"/>
        </Border>

        <!-- Feature list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status stripe -->
                                <Rectangle Grid.Column="0" Fill="{Binding Status, Converter={StaticResource StatusFg}}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,12">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingText}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource StatusBadgeBase}"
                                        Background="{Binding Status, Converter={StaticResource StatusBg}}"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                </Border>

                                <Grid Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Button Content="Apply" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ApplyCommand}"
                                            Visibility="{Binding Status, Converter={StaticResource ApplyVis}}"
                                            Padding="14,6" FontSize="12"/>
                                    <Button Content="Revert" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RevertCommand}"
                                            Visibility="{Binding Status, Converter={StaticResource RevertVis}}"
                                            Padding="12,6" FontSize="12"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
